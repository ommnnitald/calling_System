# ==============================================================================
# StreamCall Environment Configuration
# ==============================================================================

# Backend Signaling Server Configuration
# ------------------------------------------------------------------------------
# Port for Express and Socket.IO server (default: 5000)
SERVER_PORT=5000

# Host binding: 0.0.0.0 listens on all interfaces (enabling LAN access)
HOST=0.0.0.0

NODE_ENV=development

# MongoDB Connection URI (local or MongoDB Atlas mongodb+srv://...)
# Default: mongodb://127.0.0.1:27017/streamcall
MONGODB_URI=mongodb://127.0.0.1:27017/streamcall

# JSON Web Token Secret for authentication
JWT_SECRET=streamcall-super-secret-jwt-key-change-in-production

# Optional: Extra comma-separated CORS allowed origins.
# By default, localhost:5173, 127.0.0.1:5173, and detected LAN IP on 5173 are allowed.
# ALLOWED_ORIGINS=http://192.168.1.124:5173

# Frontend Client Configuration
# ------------------------------------------------------------------------------
# Optional: Explicit backend signaling server URL.
# If omitted, the client automatically connects to the server origin or LAN IP.
# VITE_SERVER_URL=https://your-domain.com
# VITE_SIGNALING_SERVER_URL=https://your-domain.com

# WebRTC STUN / TURN Configuration for Global Internet Access
# ------------------------------------------------------------------------------
# Public Google STUN servers are enabled by default.
# For users behind restrictive mobile carriers/symmetric NATs, configure a TURN server:
# VITE_TURN_SERVER_URL=turn:turn.yourdomain.com:3478
# VITE_TURN_USERNAME=your_turn_user
# VITE_TURN_CREDENTIAL=your_turn_password

# Or provide a full JSON array of ICE servers:
# VITE_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"pass"}]

# Production Single-Container Mode
# ------------------------------------------------------------------------------
# When true, Express serves the built frontend SPA from client/dist on the same port:
# SERVE_CLIENT=true


